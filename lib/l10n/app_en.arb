  "@helpTransposeS1P1": {
    "description": "Help › Transpose & chords › Change the key — point 1"
  },
  "helpTransposeS1P2": "Use - and + to move down or up one semitone at a time.",
  "@helpTransposeS1P2": {
    "description": "Help › Transpose & chords › Change the key — point 2"
  },
  "helpTransposeS1P3": "The key the sheet now sounds in is shown between the two buttons.",
  "@helpTransposeS1P3": {
    "description": "Help › Transpose & chords › Change the key — point 3"
  },
  "helpTransposeS1P4": "The line under the controls row says how far you have moved, like \"Key A (+2)\".",
  "@helpTransposeS1P4": {
    "description": "Help › Transpose & chords › Change the key — point 4"
  },
  "helpTransposeS1P5": "\"Reset\" puts the song back to its written key.",
  "@helpTransposeS1P5": {
    "description": "Help › Transpose & chords › Change the key — point 5"
  },
  "helpTransposeS1P6": "The range is 11 semitones down to 11 semitones up. A full 12 would only land on the same key again.",
  "@helpTransposeS1P6": {
    "description": "Help › Transpose & chords › Change the key — point 6"
