  "helpAutoScrollS1Heading": "Two modes",
  "@helpAutoScrollS1Heading": {
    "description": "Help › Auto-scroll › section heading"
  },
  "helpAutoScrollS1P1": "Manual scrolls at a steady speed you set yourself, from 0.10x up to 2.00x. Change it by double-tapping the sheet; each tap changes it by 0.05x.",
  "@helpAutoScrollS1P1": {
    "description": "Help › Auto-scroll › Two modes — point 1"
  },
  "helpAutoScrollS1P2": "A song remembers the speed you set for it. A song you have never set a speed for opens at the starting speed in Settings → General → Auto-scroll.",
  "@helpAutoScrollS1P2": {
    "description": "Help › Auto-scroll › Two modes — point 2"
  },
  "helpAutoScrollS1P3": "Tempo works out how long the song lasts and paces the scroll to finish exactly at the end of the song.",
