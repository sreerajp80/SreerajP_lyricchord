<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Stage Quiet Mode: lets the user grant "Do Not Disturb access" in system
         settings, which Android 7+ needs before an app may silence the ringer.
         A normal install-time permission, not a runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <!-- singleTask + documentLaunchMode="never" keep the app to ONE activity
             instance. Each FlutterActivity builds its own FlutterEngine, and each
             engine runs its own Dart isolate, which runs main() and opens its own
             SQLite connection. A second instance therefore means two connections on
             one database file, and the file-open import then failed with
             "Could not search for song by title". File managers hand a document over
             with FLAG_ACTIVITY_NEW_DOCUMENT, so documentLaunchMode="never" is needed
             as well as singleTask. Do not add taskAffinity="" back — that was what
             let the second instance start. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:documentLaunchMode="never"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
              android:name="flutter_deeplink_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Opening a ChordPro or text file by its name, from a file manager.
                 Android ignores every path rule in a filter that names no host,
                 so host="*" is required, or this filter would match EVERY file.
                 pathPattern, not pathSuffix: pathSuffix needs Android 12, and the
                 app supports Android 7. A pattern's ".*" stops at the first dot,
                 so the extra forms cover names that hold more dots
                 ("my.song.chordpro"). VIEW only: the app never edits a file in
                 place, and a share (SEND) carries no path to match. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.chordpro" />
                <data android:pathPattern=".*\\..*\\.chordpro" />
                <data android:pathPattern=".*\\..*\\..*\\.chordpro" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.chordpro" />
                <data android:pathPattern=".*\\.cho" />
                <data android:pathPattern=".*\\..*\\.cho" />
                <data android:pathPattern=".*\\..*\\..*\\.cho" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.cho" />
                <data android:pathPattern=".*\\.pro" />
                <data android:pathPattern=".*\\..*\\.pro" />
                <data android:pathPattern=".*\\..*\\..*\\.pro" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.pro" />
                <data android:pathPattern=".*\\.chopro" />
                <data android:pathPattern=".*\\..*\\.chopro" />
                <data android:pathPattern=".*\\..*\\..*\\.chopro" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.chopro" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.txt" />
            </intent-filter>
            <!-- Opening or sharing by type: ChordPro and plain-text files, shared
                 text, and several files shared at once (SEND_MULTIPLE). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-chordpro" />
                <data android:mimeType="text/x-chordpro" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
